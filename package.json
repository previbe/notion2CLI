{
  "name": "notion2cli",
  "version": "0.1.1",
  "type": "module",
  "description": "Run Claude Code or Codex directly from Notion through a local Chrome extension bridge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/previbe/notion2CLI.git"
  },
  "bugs": {
    "url": "https://github.com/previbe/notion2CLI/issues"
  },
  "homepage": "https://github.com/previbe/notion2CLI#readme",
  "keywords": [
    "notion",
    "cli",
    "codex",
    "claude",
    "chrome-extension",
    "mcp",
    "local-first"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    ".claude-plugin/",
    ".claude/commands/",
    "bin/",
    "cli/",
    "docs/",
    "extension/",
    "server/",
    "skills/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "PRIVACY.md",
    "README.md",
    "SECURITY.md",
    "chrome-store/",
    "marketing/"
  ],
  "bin": {
    "notion2cli": "bin/notion2cli.mjs",
    "notion2cli-bridge": "bin/notion2cli-bridge",
    "notion2cli-connect": "bin/notion2cli-connect",
    "notion2cli-status": "bin/notion2cli-status"
  },
  "scripts": {
    "check": "node ./scripts/check.mjs",
    "test": "node --test",
    "bridge:codex": "node ./bin/notion2cli.mjs daemon start --runtime codex --foreground",
    "bridge:claude": "node ./bin/notion2cli.mjs claude launch",
    "dev:standalone": "node ./bin/notion2cli.mjs daemon start --runtime standalone --foreground",
    "pair": "node ./bin/notion2cli.mjs pair",
    "status": "node ./bin/notion2cli.mjs status",
    "doctor": "node ./bin/notion2cli.mjs doctor",
    "package:extension": "node ./scripts/package-extension.mjs",
    "package:npm": "mkdir -p dist/npm && npm pack --pack-destination dist/npm",
    "release:check": "npm run check && npm test && npm audit --omit=dev && npm pack --dry-run && npm publish --dry-run --access public && npm run package:extension"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  }
}
