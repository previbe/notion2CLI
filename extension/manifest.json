{
  "manifest_version": 3,
  "name": "notion2CLI",
  "version": "0.1.0",
  "description": "Trigger the active Claude Code workflow directly from a Notion page.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.notion.so/*",
    "https://notion.so/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "notion2CLI",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.notion.so/*",
        "https://notion.so/*"
      ],
      "js": [
        "content-script.js"
      ],
      "css": [
        "content-style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
