#!/usr/bin/env node

import { spawn } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const runtime = process.argv[2] || 'standalone';
if (!['codex', 'standalone', 'claude'].includes(runtime)) {
  process.stderr.write('Usage: notion2cli-bridge [codex|claude|standalone]\n');
  process.exit(1);
}

const rootDir = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const cliPath = path.join(rootDir, 'bin', 'notion2cli.mjs');
const args = runtime === 'claude'
  ? [cliPath, 'claude', 'launch', ...process.argv.slice(3)]
  : [cliPath, 'daemon', 'start', '--runtime', runtime, '--foreground', ...process.argv.slice(3)];

const child = spawn(process.execPath, args, {
  stdio: 'inherit',
});

child.on('error', (error) => {
  process.stderr.write(`Error: ${error.message}\n`);
  process.exit(1);
});

child.on('close', (code, signal) => {
  if (signal) {
    process.kill(process.pid, signal);
    return;
  }

  process.exit(code ?? 0);
});
